[Unit]
Description=Middle-Drag Gestures input daemon (evdev/uinput)
Documentation=https://github.com/TahmidSwad/middle-drag-gestures/blob/main/docs/architecture.md
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/middle-drag-daemon.py
Restart=on-failure
RestartSec=2
# The daemon releases the physical device grab on SIGTERM; give it time
# to do so before systemd escalates to SIGKILL.
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
